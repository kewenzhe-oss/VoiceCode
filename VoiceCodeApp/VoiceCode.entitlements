<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Disable app sandbox to allow global hotkeys and system integration -->
    <key>com.apple.security.app-sandbox</key>
    <false/>
    
    <!-- Microphone access for voice recording -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    
    <!-- File access for temporary audio files and model storage -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    
    <!-- Network access for optional AI post-processing (future feature) -->
    <key>com.apple.security.network.client</key>
    <true/>
    
    <!-- Automation access for pasting via AppleScript -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
